---
import Layout from '../layouts/Layout.astro';

const pubModules = import.meta.glob('../content/publications/*/index.json', { eager: true });
const publications = Object.values(pubModules).map((m: any) => m.default ?? m);

const toolModules = import.meta.glob('../content/online-tools/*/index.json', { eager: true });
const tools = Object.values(toolModules).map((m: any) => m.default ?? m);

const courseModules = import.meta.glob('../content/courses/*/index.json', { eager: true });
const courses = Object.values(courseModules).map((m: any) => m.default ?? m);

const years = [...new Set(publications.map((p: any) => p.year))].sort((a: string, b: string) => Number(b) - Number(a));
const toolCategories = [...new Set(tools.map((t: any) => t.category))];
const courseCategories = [...new Set(courses.map((c: any) => c.category))];
---

<Layout title="Resources">
  <section class="min-h-screen bg-[#f1ef2e] py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-12">
        <p class="text-black font-mono text-sm tracking-widest uppercase mb-6 opacity-60">Learn More</p>
        <h1 class="font-display text-4xl md:text-6xl font-bold leading-tight mb-6 text-black">
          Resources
        </h1>
        <p class="text-black/70 text-lg leading-relaxed">
          A curated collection of publications, tools, and courses for deepening your understanding
          of circular economy design.
        </p>
      </div>

      <!-- Tab navigation -->
      <div class="flex gap-2 mb-12 border-b-2 border-black/10 pb-0">
        <button
          data-tab="publications"
          class="tab-btn px-6 py-3 text-sm font-semibold text-black border-b-2 border-black -mb-[2px] transition-colors"
        >
          Publications ({publications.length})
        </button>
        <button
          data-tab="tools"
          class="tab-btn px-6 py-3 text-sm font-semibold text-black/40 border-b-2 border-transparent -mb-[2px] hover:text-black/70 transition-colors"
        >
          Online Tools ({tools.length})
        </button>
        <button
          data-tab="courses"
          class="tab-btn px-6 py-3 text-sm font-semibold text-black/40 border-b-2 border-transparent -mb-[2px] hover:text-black/70 transition-colors"
        >
          Courses ({courses.length})
        </button>
      </div>

      <!-- PUBLICATIONS TAB -->
      <div id="tab-publications" class="tab-content">
        <div class="mb-8">
          <div class="relative max-w-md">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-black/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="pub-search"
              placeholder="Search publications..."
              class="w-full bg-black/10 border border-black/20 rounded-lg pl-12 pr-4 py-3 text-black placeholder-black/40 focus:outline-none focus:border-black/50 transition-colors"
            />
          </div>
        </div>

        {years.map(year => (
          <div class="pub-year-group mb-12" data-year={year}>
            <h2 class="font-display text-2xl font-bold text-black mb-6 border-b border-black/20 pb-2">{year}</h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
              {publications.filter(p => p.year === year).map(pub => (
                <a
                  href={pub.url || undefined}
                  target={pub.url ? '_blank' : undefined}
                  rel={pub.url ? 'noopener noreferrer' : undefined}
                  class={`pub-item group bg-black rounded-xl overflow-hidden flex flex-col ${pub.url ? 'hover:ring-2 hover:ring-white/30' : ''} transition-all`}
                  data-title={pub.title.toLowerCase()}
                >
                  {pub.image && (
                    <div class="aspect-[4/3] overflow-hidden bg-black/50">
                      <img src={pub.image} alt={pub.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                    </div>
                  )}
                  <div class="p-4 flex-1 flex flex-col">
                    <h3 class="text-white text-sm font-semibold leading-snug mb-2">{pub.title}</h3>
                    {pub.url && (
                      <div class="mt-auto pt-2">
                        <span class="text-[#f1ef2e] text-xs font-mono">View resource &rarr;</span>
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
        <div id="pub-no-results" class="hidden text-center py-12">
          <p class="text-black/60 text-lg">No matching publications found.</p>
        </div>
      </div>

      <!-- ONLINE TOOLS TAB -->
      <div id="tab-tools" class="tab-content hidden">
        <div class="mb-8">
          <div class="relative max-w-md">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-black/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="tool-search"
              placeholder="Search online tools..."
              class="w-full bg-black/10 border border-black/20 rounded-lg pl-12 pr-4 py-3 text-black placeholder-black/40 focus:outline-none focus:border-black/50 transition-colors"
            />
          </div>
        </div>

        {toolCategories.map(cat => (
          <div class="tool-cat-group mb-12" data-category={cat}>
            <h2 class="font-display text-xl font-bold text-black mb-6 border-b border-black/20 pb-2">{cat}</h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
              {tools.filter(t => t.category === cat).map(tool => (
                <a
                  href={tool.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="tool-item group bg-black rounded-xl overflow-hidden flex flex-col hover:ring-2 hover:ring-white/30 transition-all"
                  data-title={tool.title.toLowerCase()}
                >
                  <div class="aspect-[3/2] overflow-hidden flex items-center justify-center p-4" style="background-color: #f1ef2e;">
                    <img src={tool.image} alt={tool.title} class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                  </div>
                  <div class="p-4 flex-1 flex flex-col">
                    <h3 class="text-white text-sm font-semibold leading-snug mb-2">{tool.title}</h3>
                    <div class="mt-auto pt-2">
                      <span class="text-[#f1ef2e] text-xs font-mono">Visit &rarr;</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
        <div id="tool-no-results" class="hidden text-center py-12">
          <p class="text-black/60 text-lg">No matching tools found.</p>
        </div>
      </div>

      <!-- COURSES TAB -->
      <div id="tab-courses" class="tab-content hidden">
        <div class="mb-8">
          <div class="relative max-w-md">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-black/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="course-search"
              placeholder="Search courses..."
              class="w-full bg-black/10 border border-black/20 rounded-lg pl-12 pr-4 py-3 text-black placeholder-black/40 focus:outline-none focus:border-black/50 transition-colors"
            />
          </div>
        </div>

        {courseCategories.map(cat => (
          <div class="course-cat-group mb-12" data-category={cat}>
            <h2 class="font-display text-xl font-bold text-black mb-6 border-b border-black/20 pb-2">{cat}</h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {courses.filter(c => c.category === cat).map(course => (
                <a
                  href={course.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="course-item group bg-black rounded-xl overflow-hidden flex flex-col hover:ring-2 hover:ring-white/30 transition-all"
                  data-title={course.title.toLowerCase()}
                >
                  <div class="aspect-[16/9] overflow-hidden bg-white/10">
                    <img src={course.image} alt={course.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                  </div>
                  <div class="p-4 flex-1 flex flex-col">
                    <h3 class="text-white text-sm font-semibold leading-snug mb-1">{course.title}</h3>
                    {course.description && (
                      <p class="text-[#f1ef2e] text-xs font-mono mb-2">{course.description}</p>
                    )}
                    <div class="mt-auto pt-2">
                      <span class="text-[#f1ef2e] text-xs font-mono">Enroll &rarr;</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
        <div id="course-no-results" class="hidden text-center py-12">
          <p class="text-black/60 text-lg">No matching courses found.</p>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  // Tab switching
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = (btn as HTMLElement).dataset.tab;
      tabBtns.forEach(b => {
        const be = b as HTMLElement;
        be.classList.toggle('text-black', be.dataset.tab === target);
        be.classList.toggle('border-black', be.dataset.tab === target);
        be.classList.toggle('text-black/40', be.dataset.tab !== target);
        be.classList.toggle('border-transparent', be.dataset.tab !== target);
      });
      tabContents.forEach(c => {
        const ce = c as HTMLElement;
        ce.classList.toggle('hidden', ce.id !== `tab-${target}`);
      });
    });
  });

  // Search: Publications
  function setupSearch(
    inputId: string,
    itemSelector: string,
    groupSelector: string,
    noResultsId: string
  ) {
    const input = document.getElementById(inputId) as HTMLInputElement;
    const items = document.querySelectorAll(itemSelector);
    const groups = document.querySelectorAll(groupSelector);
    const noResults = document.getElementById(noResultsId);

    input?.addEventListener('input', () => {
      const query = input.value.toLowerCase().trim();
      let visible = 0;

      items.forEach(item => {
        const el = item as HTMLElement;
        const title = el.dataset.title || '';
        const text = el.textContent?.toLowerCase() || '';
        const match = !query || title.includes(query) || text.includes(query);
        el.style.display = match ? '' : 'none';
        if (match) visible++;
      });

      groups.forEach(group => {
        const g = group as HTMLElement;
        const visibleItems = Array.from(g.querySelectorAll(itemSelector)).filter(
          i => (i as HTMLElement).style.display !== 'none'
        );
        g.style.display = visibleItems.length > 0 ? '' : 'none';
      });

      if (noResults) {
        noResults.style.display = visible === 0 ? '' : 'none';
      }
    });
  }

  setupSearch('pub-search', '.pub-item', '.pub-year-group', 'pub-no-results');
  setupSearch('tool-search', '.tool-item', '.tool-cat-group', 'tool-no-results');
  setupSearch('course-search', '.course-item', '.course-cat-group', 'course-no-results');
</script>