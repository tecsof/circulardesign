---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Read contributor data from filesystem
const contributorsDir = path.join(process.cwd(), 'src/content/contributors');
const dirs = fs.readdirSync(contributorsDir).filter(d =>
  fs.statSync(path.join(contributorsDir, d)).isDirectory()
);

const contributors = dirs
  .filter(dir => fs.existsSync(path.join(contributorsDir, dir, 'index.json')))
  .map(dir => {
    const jsonPath = path.join(contributorsDir, dir, 'index.json');
    const bioPath = path.join(contributorsDir, dir, 'bio.mdoc');
    const data = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
    const bio = fs.existsSync(bioPath) ? fs.readFileSync(bioPath, 'utf-8').trim() : '';
    return { ...data, slug: dir, bio };
  })
  .sort((a, b) => a.id - b.id);

function excerpt(text: string, maxLen = 150): string {
  if (text.length <= maxLen) return text;
  return text.slice(0, text.lastIndexOf(' ', maxLen)) + '...';
}

function parseLinks(data: { link1?: string; link2?: string }) {
  const links: { url: string; label: string }[] = [];
  for (const raw of [data.link1, data.link2]) {
    if (!raw) continue;
    for (const url of raw.split('\n').map(s => s.trim()).filter(Boolean)) {
      let label = 'Website';
      if (url.includes('linkedin.com')) label = 'LinkedIn';
      else if (url.includes('orcid.org')) label = 'ORCID';
      else if (url.includes('github.com')) label = 'GitHub';
      else if (url.includes('twitter.com') || url.includes('x.com')) label = 'X';
      links.push({ url, label });
    }
  }
  return links;
}
---

<Layout title="Contributors">
  <section class="py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-16">
        <p class="text-black font-mono text-sm tracking-widest uppercase mb-6">Team</p>
        <h1 class="font-display text-4xl md:text-6xl font-bold leading-tight mb-6 text-black">
          Contributors
        </h1>
        <p class="text-black/60 text-lg leading-relaxed">
          The researchers, designers, and practitioners behind the Multi-hierarchical DfX framework
          and the Circular Design platform.
        </p>
      </div>

      <!-- Contributors grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {contributors.map((c, i) => {
          const links = parseLinks(c);
          return (
            <div class="contributor-card bg-white border border-black/5 rounded-xl p-8 shadow-sm hover:shadow-md hover:border-black/10 transition-all cursor-pointer" data-index={i}>
              <!-- Headshot -->
              <div class="flex justify-center mb-6">
                <div class="w-28 h-28 rounded-full overflow-hidden border-2 border-black/10">
                  <img
                    src={c.headshot}
                    alt={c.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              </div>

              <!-- Name -->
              <h3 class="font-display text-xl font-bold text-center mb-3 text-black">{c.name}</h3>

              <!-- Bio excerpt -->
              <p class="text-black/60 text-sm leading-relaxed text-center mb-4 bio-excerpt">
                {excerpt(c.bio)}
              </p>

              <!-- Full bio (hidden) -->
              <div class="bio-full hidden">
                <p class="text-black/60 text-sm leading-relaxed text-center mb-4">
                  {c.bio}
                </p>
              </div>

              <!-- Read more toggle -->
              {c.bio.length > 150 && (
                <div class="text-center mb-4">
                  <button class="read-more-btn text-black text-xs font-semibold underline underline-offset-2 hover:text-black/70 transition-colors">
                    Read more
                  </button>
                </div>
              )}

              <!-- Links -->
              {links.length > 0 && (
                <div class="flex justify-center gap-3 mt-auto pt-4 border-t border-black/5">
                  {links.map(link => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-xs text-black/60 hover:text-black transition-colors"
                      onclick="event.stopPropagation()"
                    >
                      {link.label === 'LinkedIn' && (
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                        </svg>
                      )}
                      {link.label === 'ORCID' && (
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 01-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-1.847-1.247-3.722-3.897-3.722h-2.422z" />
                        </svg>
                      )}
                      {link.label !== 'LinkedIn' && link.label !== 'ORCID' && (
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      )}
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.read-more-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const card = (btn as HTMLElement).closest('.contributor-card');
      if (!card) return;

      const excerptEl = card.querySelector('.bio-excerpt') as HTMLElement;
      const fullEl = card.querySelector('.bio-full') as HTMLElement;

      if (fullEl.classList.contains('hidden')) {
        fullEl.classList.remove('hidden');
        excerptEl.classList.add('hidden');
        (btn as HTMLElement).textContent = 'Read less';
      } else {
        fullEl.classList.add('hidden');
        excerptEl.classList.remove('hidden');
        (btn as HTMLElement).textContent = 'Read more';
      }
    });
  });
</script>
